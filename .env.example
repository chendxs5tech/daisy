# Copy to .env before the first `docker compose up`:
#   cp .env.example .env
# These values are only read on the FIRST start (when the volume is empty).
# Changing POSTGRES_USER/DB/PASSWORD later does not re-initialize the cluster.

POSTGRES_DB=daisy_db
POSTGRES_USER=daisy
POSTGRES_PASSWORD=change_me_local_only

# Host port mapping. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432
